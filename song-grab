#!/bin/sh
# Run under a Python that actually has the deps: prefer 3.13 if present, else
# whatever python3 the installer set up. This line is valid sh AND valid Python
# - sh execs it, Python just sees a bare string expression.
"exec" "$(command -v python3.13 || command -v python3)" "$0" "$@"
"""
song-grab: Extract songs from Instagram Reels and TikTok videos.

Usage: song-grab              (prompts for URL - no quotes needed)
       song-grab <url>        (pass URL directly - requires quotes)
       song-grab <file>       (local video/audio file - extracts its audio + identifies)
       song-grab --reindex    (rebuild every folder's "_Song Links.rtf")
       song-grab --relink     (re-find moved local source videos, then reindex)
       song-grab --watch      (background: auto-sync sources as songs are moved)

Downloads the audio, identifies the song via Shazam, finds it on YouTube,
and saves the MP3 FLAT into ~/Main/Music. Each source URL is recorded in a
hidden ledger (.song_links.tsv) AND stamped into the file's Finder comment, so
it follows the file when dragged — or even duplicated/renamed — into a category
folder; every folder gets a clickable "_Song Links.rtf" index plus a "_Sources"
folder of double-clickable shortcuts. Run --reindex after re-sorting songs to
refresh the indexes, or leave --watch running (via the launchd agent
com.samgritton.song-sources) so it happens automatically. A local source
shortcut is a symlink, so if you move the source video its shortcut breaks —
--reindex/--relink self-heals it by re-finding the file by name (Music tree,
then Spotlight across ~/Main).
"""

import asyncio
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

# --- TLS CA bundle ---------------------------------------------------------
# The python.org framework Python ships with no default cert.pem, so HTTPS
# verification fails (CERTIFICATE_VERIFY_FAILED). Point OpenSSL at certifi's
# bundle (installed alongside this interpreter) so urllib, requests and
# aiohttp/shazam all verify. Set before any network library builds a context.
if not os.environ.get("SSL_CERT_FILE"):
    try:
        import certifi
        _ca = certifi.where()
        os.environ["SSL_CERT_FILE"] = _ca
        os.environ.setdefault("REQUESTS_CA_BUNDLE", _ca)
    except Exception:
        pass

# Output directory for downloaded songs. Read from a config file rather than
# hardcoded, so `song --update` (which pulls this script from GitHub) can never
# drag someone else's music folder onto this machine — and so the published copy
# carries no personal path. Sam's config points at ~/Main/Music.
CONFIG_FILE = Path.home() / ".config" / "song-grab" / "config"


def get_output_dir() -> Path:
    """Get the output directory from the config file."""
    if CONFIG_FILE.exists():
        output_dir = CONFIG_FILE.read_text().strip()
        if output_dir:
            return Path(output_dir).expanduser()
    return Path.home() / "Music" / "SongGrab"    # default for a fresh install


OUTPUT_DIR = get_output_dir()

# Which variants to grab for every search-based download. Each run saves BOTH
# the instrumental backing track ("Title (instrumental).mp3") and the normal
# with-vocals version ("Title.mp3"). Order matters only for console output.
DOWNLOAD_VARIANTS = [True, False]  # True = instrumental, False = normal (vocals)

# --- Flat library + clickable song-links index (2026-06) -------------------
# Songs are saved FLAT in OUTPUT_DIR (no per-song wrapper folder) so they're
# easy to preview. Each source URL is recorded in a hidden ledger keyed by
# *filename*, so the link survives when the file is dragged into a category
# subfolder. Every folder gets a clickable "_Song Links.rtf" (song name =
# hyperlink to its source video), regenerated from the ledger by reindex_all().
LEDGER_PATH = OUTPUT_DIR / ".song_links.tsv"
INDEX_NAME = "_Song Links.rtf"
SOURCES_DIRNAME = "_Sources"   # per-folder folder of double-clickable source shortcuts
AUDIO_EXTS = {".mp3", ".m4a", ".mp4"}


def ledger_load() -> dict:
    links: dict = {}
    if LEDGER_PATH.exists():
        for line in LEDGER_PATH.read_text(encoding="utf-8", errors="replace").splitlines():
            if "\t" in line:
                name, url = line.split("\t", 1)
                if name:
                    links[name] = url
    return links


def ledger_set(filename: str, url: str) -> None:
    if not url:
        return
    links = ledger_load()
    links[filename] = url
    lines = [f"{n}\t{u}" for n, u in sorted(links.items(), key=lambda kv: kv[0].lower())]
    LEDGER_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")


def _rtf_escape(s: str) -> str:
    out = []
    for ch in s:
        o = ord(ch)
        if ch == "\\":
            out.append("\\\\")
        elif ch == "{":
            out.append("\\{")
        elif ch == "}":
            out.append("\\}")
        elif o < 128:
            out.append(ch)
        elif o <= 0xFFFF:
            out.append("\\u%d?" % (o if o < 32768 else o - 65536))
        else:
            o2 = o - 0x10000
            for s16 in (0xD800 + (o2 >> 10), 0xDC00 + (o2 & 0x3FF)):
                out.append("\\u%d?" % (s16 if s16 < 32768 else s16 - 65536))
    return "".join(out)


def _short_url(u: str) -> str:
    """Display label for a source under a song name. Web URLs are shortened to
    host+path; local sources (a file:// URL or a bare path) show just the source
    file's name, so the row reads e.g. 'pinterest_1234 copy.mp4'."""
    s = (u or "").strip()
    low = s.lower()
    if low.startswith("file://"):
        from urllib.parse import unquote, urlparse
        return Path(unquote(urlparse(s).path)).name
    if s.startswith(("/", "~")):
        return Path(s).expanduser().name
    for p in ("https://", "http://"):
        if s.startswith(p):
            s = s[len(p):]
    if s.startswith("www."):
        s = s[4:]
    s = s.split("?")[0].rstrip("/")
    return s if len(s) <= 64 else s[:63] + "…"


def _link_target(u: str) -> str:
    """Turn a stored source into a clickable hyperlink target. A bare local
    path can't be opened from a hyperlink — a path containing a space fails
    with Finder error -50 — so local paths become percent-encoded file:// URLs
    (e.g. '/…/foo copy.mp4' -> 'file:///…/foo%20copy.mp4'). Real URLs (http/
    https/file) pass through unchanged."""
    s = (u or "").strip()
    if s.lower().startswith(("http://", "https://", "file://")):
        return s
    try:
        return Path(s).expanduser().as_uri()
    except ValueError:
        return s  # not an absolute path — leave as-is


def _build_index_rtf(title: str, entries: list) -> str:
    head = (r"{\rtf1\ansi\ansicpg1252\cocoartf2700"
            r"{\fonttbl\f0\fswiss\fcharset0 Helvetica;\f1\fswiss\fcharset0 Helvetica-Bold;}"
            r"{\colortbl;\red0\green0\blue0;\red20\green80\blue200;\red140\green140\blue140;}"
            r"\margl1440\margr1440\f0\fs24" "\n")
    n = len(entries)
    body = [r"{\f1\fs40\cf1 " + _rtf_escape(title) + r"}\line "
            + r"{\f0\fs20\cf3 " + f"{n} song" + ("" if n == 1 else "s")
            + r" \'b7 click a song to open its source video}\line\line " + "\n"]
    q = chr(34)
    for name, url in entries:
        nm = _rtf_escape(name)
        if url:
            u = _rtf_escape(_link_target(url))
            link = r"{\field{\*\fldinst{HYPERLINK " + q + u + q + r"}}{\fldrslt "
            body.append(link + r"{\f1\fs28\cf2\ul " + nm + r"}}}\line" + "\n")
            body.append(r"\tab " + link + r"{\f0\fs18\cf3\ul "
                        + _rtf_escape(_short_url(url)) + r"}}}\line\line" + "\n")
        else:
            body.append(r"{\f1\fs28\cf1 " + nm + r"}\line" + "\n")
            body.append(r"\tab {\f0\fs18\cf3 (no source saved)}\line\line" + "\n")
    return head + "".join(body) + "}\n"


def _source_local_path(url: str) -> Path | None:
    """The local filesystem Path a source points to (bare path or file:// URL),
    or None if it's a web URL / empty."""
    s = (url or "").strip()
    if not s or s.lower().startswith(("http://", "https://")):
        return None
    if s.lower().startswith("file://"):
        from urllib.parse import unquote, urlparse
        s = unquote(urlparse(s).path)
    return Path(s).expanduser() if s.startswith(("/", "~")) else None


def _find_moved_source(base: str) -> Path | None:
    """Locate a local source that was moved, by its filename. Symlinks point at
    a fixed path, so dragging the source video into a subfolder breaks them;
    this re-finds the file wherever it now lives. Looks first inside the Music
    tree (fast, exact filename match — no glob-metachar pitfalls), then falls
    back to Spotlight across all of ~/Main. Returns None if it can't be found."""
    for root, dirs, files in os.walk(OUTPUT_DIR):   # followlinks=False: no loops
        if base in files:
            return Path(root) / base
    try:
        out = subprocess.run(
            ["mdfind", "-onlyin", str(OUTPUT_DIR.parent),
             f'kMDItemFSName == "{base}"'],
            capture_output=True, text=True, timeout=10).stdout.splitlines()
        for line in out:
            cand = Path(line)
            if cand.is_file():
                return cand
    except Exception:
        pass
    return None


def relink_ledger() -> int:
    """Self-heal local sources that were moved. For every ledger entry whose
    source is a local file no longer at the recorded path, re-find it by name
    and rewrite the ledger to its new location, so the _Sources shortcuts (and
    the .rtf links) rebuild against a live file. Web sources are left alone.
    Returns the count repaired; prints a one-line summary."""
    links = ledger_load()
    fixed, missing = 0, []
    for name, url in list(links.items()):
        local = _source_local_path(url)
        if local is None or local.exists():
            continue                       # web source, or still valid
        found = _find_moved_source(local.name)
        if found is not None:
            links[name] = str(found)
            fixed += 1
        else:
            missing.append(local.name)
    if fixed:
        lines = [f"{n}\t{u}" for n, u in sorted(links.items(), key=lambda kv: kv[0].lower())]
        LEDGER_PATH.write_text("\n".join(lines) + "\n", encoding="utf-8")
    if fixed or missing:
        msg = f"Relinked {fixed} moved source" + ("" if fixed == 1 else "s")
        if missing:
            msg += f"; {len(missing)} still missing ({', '.join(missing[:3])}" \
                   + (", …" if len(missing) > 3 else "") + ")"
        print(msg + ".")
    return fixed


def _clean_sources_dir(sources_dir: Path) -> None:
    """Remove only the shortcuts we manage (symlinks + .webloc files) from a
    _Sources folder, so a rebuild reflects renames/removals without disturbing
    anything else the user may have put there."""
    if not sources_dir.is_dir():
        return
    for p in sources_dir.iterdir():
        try:
            if p.is_symlink() or p.suffix.lower() == ".webloc":
                p.unlink()
        except OSError:
            pass


def build_folder_sources(folder: Path, entries: list) -> None:
    """(Re)build folder/_Sources — a folder of double-clickable shortcuts to
    each song's source. A local source becomes a symlink (double-click opens
    the video in your default player); a web source becomes a .webloc (opens
    the link in your browser). This is the reliable way to jump from a song to
    its source, because TextEdit and Chrome both refuse to open local file://
    links. Songs with no saved (or missing) source are skipped."""
    import plistlib
    sources_dir = folder / SOURCES_DIRNAME
    shortcuts = []  # (song_name, kind, value)  kind: "link" -> Path, "webloc" -> url
    for name, url in entries:
        local = _source_local_path(url)
        if local is not None:
            if local.exists():
                shortcuts.append((name, "link", local))
        elif (url or "").strip().lower().startswith(("http://", "https://")):
            shortcuts.append((name, "webloc", url.strip()))
    if not shortcuts:                       # nothing to link — drop a stale _Sources
        _clean_sources_dir(sources_dir)
        try:
            sources_dir.rmdir()             # only succeeds if it's now empty
        except OSError:
            pass
        return
    sources_dir.mkdir(exist_ok=True)
    _clean_sources_dir(sources_dir)
    used: set = set()

    def _dest(base: str, suffix: str) -> Path:
        safe = base.replace("/", "-").replace(":", "-").strip() or "source"
        cand = safe + suffix
        i = 2
        while cand in used or (sources_dir / cand).exists():
            cand = f"{safe} ({i}){suffix}"
            i += 1
        used.add(cand)
        return sources_dir / cand

    for name, kind, value in shortcuts:
        try:
            if kind == "link":
                _dest(name, value.suffix or ".mp4").symlink_to(value)
            else:
                _dest(name, ".webloc").write_bytes(plistlib.dumps({"URL": value}))
        except OSError:
            pass


# Resolving a song's source when its filename isn't an exact ledger key — so a
# DUPLICATED file ("song copy.mp3") or even a RENAMED one still finds its source.
# finalize_song() stamps the source URL into each file's Finder comment, so the
# source rides along *inside the file* through any Finder copy/rename; we read
# that as the authoritative fallback, then fall back to a copy/number-suffix-
# stripped ledger lookup.
_FINDER_COMMENT_XATTR = "com.apple.metadata:kMDItemFinderComment"
_COPY_SUFFIX_RE = re.compile(r"^(.*?)(?: copy(?: \d+)?| \d+)$")


_HEX_LINE_RE = re.compile(r"^[0-9A-Fa-f]{2}( [0-9A-Fa-f]{2})*$")


def _decode_finder_comment(hexstr: str) -> str:
    """Turn `xattr -px` hex into the source it holds (macOS stores the Finder
    comment as a binary plist). Returns '' if it isn't a source."""
    hexstr = hexstr.replace(" ", "").replace("\n", "").strip()
    if not hexstr:
        return ""
    try:
        raw = bytes.fromhex(hexstr)
    except ValueError:
        return ""
    val = ""
    try:
        import plistlib
        obj = plistlib.loads(raw)
        if isinstance(obj, str):
            val = obj
    except Exception:
        val = ""
    if not val:                                  # not a clean string plist — dig it out
        txt = raw.decode("utf-8", "ignore")
        m = re.search(r"(https?://\S+|file://\S+|/[^\x00]+\.(?:mp4|mov|m4v|mkv|webm))", txt)
        val = m.group(1) if m else ""
    val = (val or "").strip()
    low = val.lower()
    if low.startswith(("http://", "https://", "file://")) or val.startswith(("/", "~")):
        return val
    return ""


def _finder_comment_source(path: Path) -> str:
    """The source URL/path stamped into a file's Finder comment by
    finalize_song() — or pasted in by hand in Get Info. Read via `xattr`
    (macOS stores it as a binary plist, which rides along inside the file when
    it's duplicated/renamed in Finder — that's what lets a song carry its
    source with it). os.getxattr is Linux-only, so we shell out."""
    try:
        out = subprocess.run(["xattr", "-px", _FINDER_COMMENT_XATTR, str(path)],
                             capture_output=True, text=True, timeout=10)
    except Exception:
        return ""
    if out.returncode != 0:
        return ""
    return _decode_finder_comment(out.stdout)


def _finder_comments_batch(paths: list) -> dict:
    """Finder comments for many files in ONE `xattr` call — ~30ms for the whole
    library, versus a subprocess per file. Returns {path_str: source}; files
    with no comment (they land on stderr) are simply absent.

    With several files `xattr -px` prints a "<path>: " header before each file's
    hex block; with exactly one it prints the hex bare, so seed `current`."""
    if not paths:
        return {}
    paths = [str(p) for p in paths]
    try:
        out = subprocess.run(["xattr", "-px", _FINDER_COMMENT_XATTR] + paths,
                             capture_output=True, text=True, timeout=120)
    except Exception:
        return {}

    comments: dict = {}
    current = paths[0] if len(paths) == 1 else None
    hexbuf: list = []

    def flush():
        if current is None:
            return
        val = _decode_finder_comment("".join(hexbuf))
        if val:
            comments[current] = val

    for raw in out.stdout.splitlines():
        line = raw.strip()
        if not line:
            continue
        if _HEX_LINE_RE.match(line):
            hexbuf.append(line)
        elif line.endswith(":"):
            flush()
            current, hexbuf = line[:-1], []
    flush()
    return comments


def _strip_copy_suffix(stem: str) -> str:
    """'song copy' / 'song copy 2' / 'song 2' -> 'song'  (else '')."""
    m = _COPY_SUFFIX_RE.match(stem)
    base = m.group(1).strip() if m else ""
    return base if base and base != stem else ""


def _resolve_source(audio: Path, links: dict, comments: dict | None = None) -> str:
    """Best source for a song file sitting in a category folder, even if it was
    duplicated or renamed.

    The Finder comment WINS over the ledger. That's deliberate: Get Info is the
    field edited by hand when a download turned out to be the wrong song — grab
    the right track off YouTube, then paste the original reel/TikTok URL into
    its Get Info. That hand-pasted URL is the correction, so it has to beat the
    ledger's stale (usually YouTube) entry, otherwise the _Sources shortcut
    keeps pointing at YouTube instead of the reel the editors need.

    Order: Finder comment (survives copy/rename) -> exact ledger key ->
    copy/number-suffix-stripped ledger lookup. '' if nothing is found."""
    embedded = (comments.get(str(audio), "") if comments is not None
                else _finder_comment_source(audio))
    if embedded:
        return embedded
    exact = links.get(audio.name)
    if exact:
        return exact
    base = _strip_copy_suffix(audio.stem)
    if base:
        return links.get(base + audio.suffix, "")
    return ""


def _all_audio_paths() -> list:
    """Every song under the Music tree, skipping dotfiles and _Sources."""
    out = []
    for root, dirs, files in os.walk(OUTPUT_DIR):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != SOURCES_DIRNAME]
        for f in files:
            if not f.startswith(".") and Path(f).suffix.lower() in AUDIO_EXTS:
                out.append(os.path.join(root, f))
    return out


def build_folder_index(folder: Path, links: dict | None = None,
                       comments: dict | None = None) -> None:
    """(Re)write folder/_Song Links.rtf and folder/_Sources for the audio files
    directly inside `folder`. Removes both if the folder has no audio."""
    if links is None:
        links = ledger_load()
    audio = sorted((p for p in folder.iterdir()
                    if p.is_file() and p.suffix.lower() in AUDIO_EXTS),
                   key=lambda p: p.stem.lower())
    index_path = folder / INDEX_NAME
    if not audio:
        if index_path.exists():
            index_path.unlink()
        build_folder_sources(folder, [])
        return
    title = "Music — unsorted" if folder == OUTPUT_DIR else folder.name

    entries = []
    for p in audio:
        src = _resolve_source(p, links, comments)
        entries.append((p.stem, src))
        # A hand-edited Get Info comment is a correction — fold it back into the
        # ledger so the .rtf index, _Sources and later reindexes all agree.
        if src and links.get(p.name) != src:
            ledger_set(p.name, src)
            links[p.name] = src

    index_path.write_text(_build_index_rtf(title, entries), encoding="utf-8")
    build_folder_sources(folder, entries)


def reindex_all() -> None:
    """Rebuild every _Song Links.rtf — the Music root (unsorted inbox) plus
    each category subfolder — from the ledger. First self-heals any local
    sources that were moved, so their shortcuts rebuild against live files."""
    relink_ledger()
    links = ledger_load()
    comments = _finder_comments_batch(_all_audio_paths())   # one call, ~30ms
    build_folder_index(OUTPUT_DIR, links, comments)
    for sub in sorted(OUTPUT_DIR.iterdir()):
        if sub.is_dir() and not sub.name.startswith(".") and sub.name != SOURCES_DIRNAME:
            build_folder_index(sub, links, comments)
    print("Reindexed song links.")


def _audio_layout_signature() -> frozenset:
    """Snapshot of where every song lives AND what source each one claims — the
    set of (audio path, Finder comment) pairs under the Music tree, skipping
    dotfiles and the generated _Sources folders (so our own rebuilds never look
    like a change). Comparing two snapshots tells the watcher a song was moved,
    copied or renamed — and, because the comment is in the pair, that a source
    was edited by hand in Get Info, which must repoint its _Sources shortcut.
    The comments come from one batched xattr call, so the poll stays cheap."""
    paths = _all_audio_paths()
    comments = _finder_comments_batch(paths)
    return frozenset((p, comments.get(p, "")) for p in paths)


def watch_loop(interval: float = 2.0, settle: float = 2.0) -> None:
    """Watch the Music tree and re-sync every folder's _Sources/_Song Links.rtf
    whenever songs move between folders — so a song dragged or duplicated into a
    new category automatically gets its source shortcut there. Polls the (cheap)
    audio layout, waits for a drag to settle, then runs reindex_all(). Runs
    forever; the launchd agent (KeepAlive) restarts it if it ever exits. The
    signature ignores _Sources/.rtf/dotfiles, so reindex's own writes can't
    retrigger it."""
    import time
    print(f"[song --watch] watching {OUTPUT_DIR} (poll {interval}s)", flush=True)
    try:
        reindex_all()                       # catch up on moves made while it was off
    except Exception as e:
        print(f"[song --watch] initial reindex failed: {e}", flush=True)
    last = _audio_layout_signature()
    while True:
        time.sleep(interval)
        try:
            cur = _audio_layout_signature()
        except Exception:
            continue
        if cur == last:
            continue
        while True:                         # wait until the layout stops changing
            time.sleep(settle)
            try:
                nxt = _audio_layout_signature()
            except Exception:
                break
            if nxt == cur:
                break
            cur = nxt
        try:
            reindex_all()
            print(f"[song --watch] re-synced ({len(cur)} songs)", flush=True)
        except Exception as e:
            print(f"[song --watch] reindex failed: {e}", flush=True)
        last = cur


def sanitize_filename(name: str) -> str:
    """Remove characters that are invalid in filenames."""
    # Replace problematic characters with safe alternatives
    name = re.sub(r'[<>:"/\\|?*]', '', name)
    name = re.sub(r'\s+', ' ', name)  # Collapse multiple spaces
    return name.strip()


def format_timestamp(seconds: float) -> str:
    """Convert seconds to M.SS format (e.g., 82.5 -> '1.22')"""
    minutes = int(seconds // 60)
    secs = int(seconds % 60)
    return f"{minutes}.{secs:02d}"


def set_finder_comment(file_path: Path, comment: str) -> bool:
    """Set the Finder comment (visible in Get Info) for a file."""
    try:
        # Use AppleScript to set Finder comment - more reliable than xattr
        escaped_path = str(file_path).replace('"', '\\"')
        escaped_comment = comment.replace('\\', '\\\\').replace('"', '\\"')
        script = f'tell application "Finder" to set comment of (POSIX file "{escaped_path}" as alias) to "{escaped_comment}"'
        subprocess.run(["osascript", "-e", script], capture_output=True, check=True)
        return True
    except Exception as e:
        # Non-fatal - the ID3 comment is still saved
        return False


def already_downloaded(output_path: Path) -> Path | None:
    """Return the existing path if the song was already downloaded — either
    at the original location, or wrapped into a folder by finalize_song().
    Returns None if not found."""
    if output_path.exists():
        return output_path
    wrapped = output_path.parent / output_path.stem / output_path.name
    if wrapped.exists():
        return wrapped
    return None


def finalize_song(audio_path: Path, source_url: str, reindex: bool = True) -> Path:
    """Register a freshly-downloaded song. The file stays FLAT where it is
    (in OUTPUT_DIR) — no per-song wrapper folder. We record its source URL in
    the links ledger (keyed by filename, so it follows the file when dragged
    into a category), embed the URL as a Finder comment as a backup, and
    refresh the clickable _Song Links.rtf indexes. Returns the audio path.
    """
    ledger_set(audio_path.name, source_url)
    set_finder_comment(audio_path, source_url)
    if reindex:
        reindex_all()
    return audio_path


def save_failed_url(url: str) -> Path:
    """Record a URL we couldn't identify into OUTPUT_DIR/failed/ as a .txt
    file, so it can be retried later. Filename uses the post shortcode/video-id
    when extractable, otherwise a timestamp."""
    failed_dir = OUTPUT_DIR / "failed"
    failed_dir.mkdir(parents=True, exist_ok=True)

    ig_match = re.search(r'instagram\.com/(?:reel|reels|p|tv)/([^/?#]+)', url)
    tt_match = re.search(r'tiktok\.com/.*?/video/(\d+)', url)
    if ig_match:
        ident = f"instagram_{ig_match.group(1)}"
    elif tt_match:
        ident = f"tiktok_{tt_match.group(1)}"
    else:
        ident = datetime.now().strftime("failed_%Y%m%d_%H%M%S")

    failed_path = failed_dir / f"{ident}.txt"
    failed_path.write_text(url + "\n", encoding="utf-8")
    return failed_path


