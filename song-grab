def resolve_local_path(s: str) -> Path | None:
    """If `s` points to an existing local media file, return its resolved Path,
    else None. Handles file:// URLs, ~ expansion, surrounding quotes, and
    backslash-escaped spaces (drag-and-drop / shell-style paths)."""
    raw = (s or "").strip()
    if not raw:
        return None
    if raw.lower().startswith("file://"):
        from urllib.parse import unquote, urlparse
        raw = unquote(urlparse(raw).path)
    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in ("'", '"'):
        raw = raw[1:-1]
    candidates = [raw]
    if "\\" in raw:
        candidates.append(re.sub(r"\\(.)", r"\1", raw))  # un-escape "\ " etc.
    for c in candidates:
        p = Path(c).expanduser()
        if p.is_file():
            return p.resolve()
    return None


def extract_local_audio(file_path: Path, output_path: Path) -> bool:
    """Extract/transcode audio from a local media file (video OR audio) to mp3."""
    print(f"Extracting audio from local file: {file_path.name}")
    cmd = [
        "ffmpeg", "-y", "-loglevel", "error",
        "-i", str(file_path),
        "-vn", "-ac", "1", "-ar", "44100", "-b:a", "192k",
        str(output_path),
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error extracting audio: {result.stderr.strip()[:300]}")
        return False
    return output_path.exists()


def download_source_audio(url: str, output_path: Path, source_url: str = "") -> bool:
    """Download audio from Instagram/TikTok using yt-dlp."""
    print(f"Downloading audio from source...")

    # Check if this is a TikTok slideshow (photo post)
    if "tiktok.com" in url.lower() and "/photo/" in url.lower():
        print("Detected TikTok slideshow, using alternate download method...")
        return download_tiktok_slideshow_audio(url, output_path, source_url or url)

    cmd = [
        "yt-dlp",
        "--cookies-from-browser", "chrome",
        "-x",
        "--audio-format", "mp3",
        "--audio-quality", "0",
        "-o", str(output_path),
        "--no-playlist",
        "--quiet",
        "--progress",
        url
    ]

    result = subprocess.run(cmd, capture_output=True, text=True)

    if result.returncode != 0:
        # yt-dlp failed — try direct TikTok download as fallback
        if "tiktok.com" in url.lower():
            print("yt-dlp failed, trying direct TikTok download...")
            return download_tiktok_slideshow_audio(url, output_path, source_url or url)
        print(f"Error downloading: {result.stderr}")
        return False

    return output_path.exists()


async def identify_with_shazam(audio_path: Path) -> dict | None:
    """Use ShazamIO to identify the song in the audio file."""
    from shazamio import Shazam

    shazam = Shazam()

    try:
        result = await shazam.recognize(str(audio_path))

        if result and "track" in result:
            track = result["track"]
            # Get offset from first match
            offset = None
            if result.get("matches") and len(result["matches"]) > 0:
                offset = result["matches"][0].get("offset")
            return {
                "title": track.get("title", "Unknown"),
                "artist": track.get("subtitle", "Unknown Artist"),
                "full_title": track.get("share", {}).get("subject", ""),
                "offset": offset,
            }
    except Exception as e:
        print(f"Shazam error: {e}")

    return None


def identify_with_acrcloud(audio_path: Path) -> dict | None:
    """Use ACRCloud for music identification (best for noisy content)."""
    import hashlib
    import hmac
    import base64
    import json
    import time
    import urllib.request

    access_key = os.environ.get("ACRCLOUD_ACCESS_KEY", "")
    access_secret = os.environ.get("ACRCLOUD_ACCESS_SECRET", "")
    host = os.environ.get("ACRCLOUD_HOST", "identify-us-west-2.acrcloud.com")

    if not access_key or not access_secret:
        return None

    try:
        with open(audio_path, "rb") as f:
            sample = f.read()

        # Build HMAC signature
        timestamp = str(int(time.time()))
        string_to_sign = f"POST\n/v1/identify\n{access_key}\naudio\n1\n{timestamp}"
        sign = base64.b64encode(
            hmac.new(access_secret.encode(), string_to_sign.encode(), hashlib.sha1).digest()
        ).decode()

        # Build multipart form data
        boundary = f"----SongGrab{int(time.time())}"
        body = b""
        for key, value in [
            ("access_key", access_key),
            ("data_type", "audio"),
            ("signature_version", "1"),
            ("signature", sign),
            ("sample_bytes", str(len(sample))),
            ("timestamp", timestamp),
        ]:
            body += f"--{boundary}\r\n".encode()
            body += f'Content-Disposition: form-data; name="{key}"\r\n\r\n'.encode()
            body += f"{value}\r\n".encode()

        body += f"--{boundary}\r\n".encode()
        body += b'Content-Disposition: form-data; name="sample"; filename="sample.mp3"\r\n'
        body += b"Content-Type: application/octet-stream\r\n\r\n"
        body += sample
        body += f"\r\n--{boundary}--\r\n".encode()

        req = urllib.request.Request(
            f"https://{host}/v1/identify",
            data=body,
            headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
            method="POST",
        )

        with urllib.request.urlopen(req, timeout=30) as response:
            result = json.loads(response.read().decode("utf-8"))

        if result.get("status", {}).get("code") == 0:
            music = result["metadata"]["music"][0]
            title = music.get("title", "Unknown")
            artists = music.get("artists", [{}])
            artist = artists[0].get("name", "Unknown Artist") if artists else "Unknown Artist"
            return {
                "title": title,
                "artist": artist,
                "full_title": f"{artist} - {title}",
                "offset": None,
                "score": music.get("score", 0),
            }
    except Exception as e:
        print(f"ACRCloud error: {e}")

    return None


def identify_with_audd(audio_path: Path) -> dict | None:
    """Use AudD as a fallback for song identification."""
    import base64
    import json
    import urllib.request
    import urllib.error

    try:
        with open(audio_path, "rb") as f:
            audio_data = base64.b64encode(f.read()).decode("utf-8")

        data = {
            "audio": audio_data,
            "return": "spotify",
        }
        api_token = os.environ.get("AUDD_API_TOKEN")
        if api_token:
            data["api_token"] = api_token

        req = urllib.request.Request(
            "https://api.audd.io/",
            data=urllib.parse.urlencode(data).encode(),
            method="POST",
        )

        with urllib.request.urlopen(req, timeout=30) as response:
            result = json.loads(response.read().decode("utf-8"))

        if result.get("status") == "success" and result.get("result"):
            track = result["result"]
            # Parse timecode (format "MM:SS") to seconds
            offset = None
            timecode = track.get("timecode")
            if timecode:
                try:
                    parts = timecode.split(":")
                    if len(parts) == 2:
                        offset = int(parts[0]) * 60 + int(parts[1])
                except (ValueError, AttributeError):
                    pass
            return {
                "title": track.get("title", "Unknown"),
                "artist": track.get("artist", "Unknown Artist"),
                "full_title": f"{track.get('artist', '')} - {track.get('title', '')}",
                "offset": offset,
            }
    except urllib.error.HTTPError as e:
        if e.code == 429:
            print("AudD rate limit reached (free tier: ~300/month)")
        else:
            print(f"AudD HTTP error: {e}")
    except Exception as e:
        print(f"AudD error: {e}")

    return None


def get_audio_duration(audio_path: Path) -> float:
    """Get the duration of an audio file in seconds."""
    cmd = [
        "ffprobe", "-v", "quiet", "-show_entries", "format=duration",
        "-of", "csv=p=0", str(audio_path)
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    try:
        return float(result.stdout.strip())
    except (ValueError, AttributeError):
        return 0.0


def extract_audio_segment(audio_path: Path, output_path: Path, start: float, duration: float = 15) -> bool:
    """Extract a segment from an audio file."""
    cmd = [
        "ffmpeg", "-y", "-i", str(audio_path),
        "-ss", str(start), "-t", str(duration),
        "-q:a", "0", str(output_path)
    ]
    result = subprocess.run(cmd, capture_output=True)
    return output_path.exists()


def reduce_vocals(audio_path: Path, output_path: Path) -> bool:
    """Reduce vocal frequencies to help song identification.

    Applies a band-reject filter on typical vocal range (300-3000 Hz)
    and boosts bass/treble where music is more prominent.
    """
    cmd = [
        "ffmpeg", "-y", "-i", str(audio_path),
        "-af", "bandreject=f=1000:width_type=h:w=1500,bass=g=3,treble=g=3",
        "-q:a", "0", str(output_path)
    ]
    result = subprocess.run(cmd, capture_output=True)
    return output_path.exists()


def check_demucs() -> bool:
    """Check if demucs CLI is installed and runnable."""
    try:
        result = subprocess.run(
            ["demucs", "--help"], capture_output=True, timeout=10
        )
        return result.returncode == 0
    except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired):
        return False


def separate_vocals_demucs(audio_path: Path, work_dir: Path) -> Path | None:
    """Use Demucs to isolate the music (no-vocals) stem and return its path.

    Slow (~10-60s depending on hardware) but cleanly removes voiceovers and SFX
    that the bandreject filter can't touch. Used as a last-resort fallback when
    normal identification fails.
    """
    if not check_demucs():
        print("  Demucs not installed — install with: pip3 install demucs")
        return None

    print("Isolating music stem with Demucs (this may take 10-60s)...")
    work_dir.mkdir(parents=True, exist_ok=True)
    cmd = [
        "demucs",
        "--two-stems=vocals",
        "--mp3",
        "-o", str(work_dir),
        str(audio_path),
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        err = (result.stderr or result.stdout or "").strip()
        print(f"  Demucs failed: {err[:300]}")
        return None

    # Demucs writes to <work_dir>/<model_name>/<basename>/no_vocals.mp3
    stem_name = audio_path.stem
    for model_dir in work_dir.iterdir():
        if not model_dir.is_dir():
            continue
        candidate = model_dir / stem_name / "no_vocals.mp3"
        if candidate.exists():
            return candidate
    print("  Demucs output not found at expected path.")
    return None


async def retry_identify_song(audio_path: Path, retry_count: int) -> dict | None:
    """Identify song using different segments than the normal flow.

    Normal flow tries: middle, 75%, beginning.
    Retry tries: 25%, very end, 40%, plus speed-shifted versions.
    """
    total_duration = get_audio_duration(audio_path)
    if total_duration < 8:
        print(f"Audio too short for retry ({total_duration:.1f}s).")
        return None

    samples = []
    temp_dir = audio_path.parent

    if total_duration > 15:
        if retry_count == 0:
            # Retry 1: 25% mark and very end — different from normal middle/75%/beginning
            early_start = max(0, total_duration * 0.25 - 6)
            early_path = temp_dir / "retry_early.mp3"
            if extract_audio_segment(audio_path, early_path, early_start, 12):
                samples.append(("25% mark", early_path))

            end_start = max(0, total_duration - 12)
            end_path = temp_dir / "retry_end.mp3"
            if extract_audio_segment(audio_path, end_path, end_start, 12):
                samples.append(("very end", end_path))
        elif retry_count == 1:
            # Retry 2: 40% mark and 60% mark
            mark40_start = max(0, total_duration * 0.4 - 6)
            mark40_path = temp_dir / "retry_40.mp3"
            if extract_audio_segment(audio_path, mark40_path, mark40_start, 12):
                samples.append(("40% mark", mark40_path))

            mark60_start = max(0, total_duration * 0.6 - 6)
            mark60_path = temp_dir / "retry_60.mp3"
            if extract_audio_segment(audio_path, mark60_path, mark60_start, 12):
                samples.append(("60% mark", mark60_path))
        else:
            # Retry 3: speed-shifted full audio (catches sped up/slowed songs)
            fast_path = temp_dir / "retry_fast.mp3"
            cmd = ["ffmpeg", "-y", "-i", str(audio_path), "-af", "atempo=0.92", "-q:a", "0", str(fast_path)]
            subprocess.run(cmd, capture_output=True)
            if fast_path.exists():
                samples.append(("slowed 8%", fast_path))

            slow_path = temp_dir / "retry_slow.mp3"
            cmd = ["ffmpeg", "-y", "-i", str(audio_path), "-af", "atempo=1.08", "-q:a", "0", str(slow_path)]
            subprocess.run(cmd, capture_output=True)
            if slow_path.exists():
                samples.append(("sped 8%", slow_path))
    else:
        # Short audio — try speed-shifted versions
        fast_path = temp_dir / "retry_fast.mp3"
        cmd = ["ffmpeg", "-y", "-i", str(audio_path), "-af", "atempo=0.92", "-q:a", "0", str(fast_path)]
        subprocess.run(cmd, capture_output=True)
        if fast_path.exists():
            samples.append(("slowed 8%", fast_path))

        slow_path = temp_dir / "retry_slow.mp3"
        cmd = ["ffmpeg", "-y", "-i", str(audio_path), "-af", "atempo=1.08", "-q:a", "0", str(slow_path)]
        subprocess.run(cmd, capture_output=True)
        if slow_path.exists():
            samples.append(("sped 8%", slow_path))

    if not samples:
        print("Could not generate retry samples.")
        return None

    # Per-segment iteration. ACRCloud >= 70 short-circuits. Weak ACRCloud
    # plus an AudD/Shazam alternative returns combined candidates.
    weak_acrcloud: dict | None = None
    audd_match: dict | None = None
    shazam_match: dict | None = None
    has_acrcloud = os.environ.get("ACRCLOUD_ACCESS_KEY")
    for label, sample_path in samples:
        print(f"  Trying {label}...")
        if has_acrcloud:
            result = identify_with_acrcloud(sample_path)
            if result:
                score = result.get("score", 0)
                if score >= 70:
                    result["service"] = "acrcloud"
                    print(f"  ACRCloud matched on {label} (score {score})")
                    return result
                if weak_acrcloud is None or score > weak_acrcloud.get("score", 0):
                    weak_acrcloud = result
        if not audd_match:
            result = identify_with_audd(sample_path)
            if result:
                audd_match = result
                print(f"  AudD matched on {label}")
        if not shazam_match:
            result = await identify_with_shazam(sample_path)
            if result:
                shazam_match = result
                print(f"  Shazam matched on {label}")

    if weak_acrcloud:
        weak_acrcloud["service"] = "acrcloud"
    if audd_match:
        audd_match["service"] = "audd"
    if shazam_match:
        shazam_match["service"] = "shazam"

    if weak_acrcloud and (audd_match or shazam_match):
        candidates: list[dict] = []
        seen: set[tuple[str, str]] = set()
        for c in [weak_acrcloud, audd_match, shazam_match]:
            if not c:
                continue
            key = (c["artist"].lower().strip(), c["title"].lower().strip())
            if key in seen:
                continue
            seen.add(key)
            candidates.append(c)
        primary = candidates[0]
        if len(candidates) > 1:
            primary["_alternates"] = candidates[1:]
            print(f"  Services disagree on {len(candidates)} songs — will download each.")
        return primary

    if audd_match:
        return audd_match
    if shazam_match:
        return shazam_match
    if weak_acrcloud:
        print(f"  Falling back to ACRCloud's weak match (score {weak_acrcloud.get('score')}).")
        return weak_acrcloud
    return None


async def identify_song_candidates(
    audio_path: Path,
    start_offset: int | None = None,
    source_label: str = "",
    seen_keys: set | None = None,
    min_acr_score: int = 50,
) -> list[dict]:
    """Run all 3 services across all segments. Keep ACRCloud matches with
    score >= min_acr_score (default 50) plus every unique AudD/Shazam match.
    Pass `seen_keys` to extend a dedupe set across multiple calls (e.g. raw
    audio + demucs stem)."""
    total_duration = get_audio_duration(audio_path)
    samples = []
    temp_dir = audio_path.parent

    if start_offset is not None:
        if total_duration > start_offset + 3:
            offset_path = temp_dir / "cand_offset.mp3"
            if extract_audio_segment(audio_path, offset_path, start_offset, 15):
                samples.append((f"{start_offset}s mark", offset_path))
            if total_duration > start_offset + 18:
                offset2_path = temp_dir / "cand_offset2.mp3"
                if extract_audio_segment(audio_path, offset2_path, start_offset + 15, 15):
                    samples.append((f"{start_offset + 15}s mark", offset2_path))
        if not samples:
            samples.append(("full", audio_path))
    elif total_duration > 20:
        mid_start = max(0, (total_duration / 2) - 7.5)
        mid_path = temp_dir / "cand_mid.mp3"
        if extract_audio_segment(audio_path, mid_path, mid_start, 15):
            samples.append(("middle", mid_path))
        late_start = max(0, total_duration * 0.75 - 7.5)
        late_path = temp_dir / "cand_late.mp3"
        if extract_audio_segment(audio_path, late_path, late_start, 15):
            samples.append(("late", late_path))
        begin_path = temp_dir / "cand_begin.mp3"
        if extract_audio_segment(audio_path, begin_path, 0, 15):
            samples.append(("beginning", begin_path))
    else:
        samples.append(("full", audio_path))

    candidates: list[dict] = []
    if seen_keys is None:
        seen_keys = set()

    src_tag = f" {source_label}" if source_label else ""

    def add(result: dict | None, service: str, label: str) -> bool:
        if not result:
            return False
        key = (result["artist"].lower().strip(), result["title"].lower().strip())
        score = result.get("score")
        score_str = f" (score {score})" if score is not None else ""
        if key in seen_keys:
            print(f"  [{service}]{src_tag} [{label}] dup: {result['artist']} - {result['title']}{score_str}")
            return False
        seen_keys.add(key)
        result["service"] = service
        result["segment"] = label
        if source_label:
            result["source_label"] = source_label
        candidates.append(result)
        print(f"  [{service}]{src_tag} [{label}] {result['artist']} - {result['title']}{score_str}")
        return True

    has_acrcloud = os.environ.get("ACRCLOUD_ACCESS_KEY")
    if has_acrcloud:
        print(f"Querying ACRCloud across segments{src_tag}...")
        for label, sample_path in samples:
            result = identify_with_acrcloud(sample_path)
            if not result:
                continue
            score = result.get("score", 0)
            if score < min_acr_score:
                print(f"  [acrcloud]{src_tag} [{label}] below threshold (score {score}): {result.get('artist')} - {result.get('title')}")
                continue
            add(result, "acrcloud", label)

    print(f"Querying AudD across segments{src_tag}...")
    for label, sample_path in samples:
        add(identify_with_audd(sample_path), "audd", label)

    print(f"Querying Shazam across segments{src_tag}...")
    for label, sample_path in samples:
        add(await identify_with_shazam(sample_path), "shazam", label)

    return candidates


def download_candidates_flat(
    candidates: list[dict], source_url: str
) -> tuple[int, Path]:
    """For 2+ candidates: download each one as a FLAT mp3 in OUTPUT_DIR (plus a
    YouTube top-result per unique title), recording each source URL in the links
    ledger. Each candidate is saved in BOTH variants (instrumental + normal).
    Preview them, keep the one you want, drag it into a category folder.
    Returns (saved_count, OUTPUT_DIR)."""
    # Recognition often picks the wrong artist on instrumentals (matches karaoke
    # channels or title-coincident songs). Add a "title-only" pseudo-candidate
    # per unique title so we also grab YouTube's top organic result for the bare
    # title — what a human would search.
    augmented: list[dict] = list(candidates)
    seen_titles: set[str] = set()
    for c in candidates:
        title_key = c["title"].lower().strip()
        if title_key in seen_titles:
            continue
        seen_titles.add(title_key)
        augmented.append({
            "artist": "",
            "title": c["title"],
            "service": "yt-title-search",
            "segment": "",
            "title_only": True,
        })

    saved = 0
    for c in augmented:
        artist = c["artist"]
        title = c["title"]
        service = c.get("service", "alt")
        title_only = c.get("title_only", False)
        display_name = title if title_only else f"{artist} - {title}"

        used_ids: set = set()   # never let two variants land on the same video
        for instrumental in DOWNLOAD_VARIANTS:
            inst_suffix = " (instrumental)" if instrumental else ""
            variant = "instrumental" if instrumental else "normal"
            if title_only:
                basename = sanitize_filename(f"{title}{inst_suffix} (yt-top-result)")
            else:
                basename = sanitize_filename(f"{title}{inst_suffix}")
            flat_audio = OUTPUT_DIR / f"{basename}.mp3"

            if flat_audio.exists():
                print(f"  [{service}] already saved: {basename}")
                saved += 1
                continue

            yt_url = search_youtube(artist, title, instrumental=instrumental,
                                    exclude_ids=used_ids)
            if not yt_url:
                print(f"  [{service}] no YouTube result for {display_name} ({variant})")
                continue
            used_ids.add(_yt_video_id(yt_url))
            if not download_youtube_mp3(yt_url, flat_audio, source_url):
                print(f"  [{service}] YouTube download failed for {display_name} ({variant})")
                continue

            finalize_song(flat_audio, source_url, reindex=False)
            print(f"  [{service}] saved: {basename}")
            saved += 1

    if saved:
        reindex_all()
    return saved, OUTPUT_DIR


# --- YouTube result picking -------------------------------------------------
# Taking YouTube's #1 hit is not good enough. A bare "<artist> <title>" search
# returns the Official Music Video (extra intro/outro dialogue, wrong length),
# and an "<artist> <title> instrumental" search returns a backing track. So each
# variant asks for what it actually wants and then SCORES the top few results,
# hard-rejecting anything that contradicts the variant.

# Title words meaning "not the studio recording with vocals".
_INSTRUMENTAL_MARKERS = (
    "instrumental", "karaoke", "backing track", "no vocals", "without vocals",
    "minus one", "acapella", "a cappella",
)

# Never a usable song file, whatever the reel played.
_ALWAYS_JUNK = (
    "reaction", "tutorial", "how to play", "guitar lesson", "8d audio",
    "1 hour", "one hour", "10 hours", "1hour", "full album",
)

# Edits of a track. These are NOT junk by default — if the reel played the sped
# up / slowed / remixed cut, that's the cut Sam wants, so a wanted variant is a
# BONUS and its absence is a penalty. Only unwanted ones are junk. Keys are the
# canonical name, values the spellings seen in YouTube titles.
_VARIANT_FAMILIES = {
    "sped up":   ("sped up", "sped-up", "spedup", "speed up", "speeded up"),
    "slowed":    ("slowed", "slowed down", "slow down", "slowed reverb"),
    "reverb":    ("reverb",),
    "nightcore": ("nightcore",),
    "remix":     ("remix", "rmx", "bootleg"),
    "mashup":    ("mashup", "mash-up"),
    "extended":  ("extended",),
    "loop":      ("loop", "looped"),
    "live":      ("live",),
    "acoustic":  ("acoustic",),
    "cover":     ("cover",),
}

# Set from --variant/--sped-up/--slowed/... to force a cut when recognition
# reports the plain title but the reel actually played an edit.
VARIANT_HINT: str = ""

# Preferred shapes of the real recording, best first. "lyrics" is the key one —
# it reliably lands on the plain audio rather than the music video.
_VOCAL_BONUS = (("lyrics", 30), ("official audio", 28), ("(audio)", 24))

_GOOD_ENOUGH = 45   # stop querying once a candidate scores this well


def _yt_search(query: str, limit: int = 6) -> list[dict]:
    """Return the top `limit` YouTube hits as dicts (id/duration/channel/title).
    Uses --flat-playlist so this is one cheap call, not per-video extraction."""
    cmd = [
        "yt-dlp",
        "--default-search", f"ytsearch{limit}",
        "--flat-playlist",
        "--no-warnings",
        "--quiet",
        "--print", "%(id)s\t%(duration)s\t%(channel)s\t%(title)s",
        query,
    ]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return []

    hits = []
    for line in result.stdout.strip().split("\n"):
        parts = line.split("\t")
        if len(parts) < 4 or len(parts[0]) != 11:
            continue
        try:
            duration = float(parts[1])
        except (ValueError, TypeError):
            duration = None
        hits.append({
            "id": parts[0], "duration": duration,
            "channel": parts[2], "title": parts[3],
        })
    return hits


def _has_marker(text: str, phrase: str) -> bool:
    """Whole-word match, so 'live' doesn't fire on 'alive'/'delivery' and
    'cover' doesn't fire on 'discover'."""
    return re.search(r"\b" + re.escape(phrase) + r"\b", text) is not None


def _wanted_variants(title: str) -> set:
    """Which edits of the track we're actually after — read off the recognised
    title (recognition usually names the cut the reel played, e.g. 'lovely -
    Sped Up Version'), plus any --variant override. Returns canonical names."""
    hay = f"{title} {VARIANT_HINT}".lower()
    return {canon for canon, spellings in _VARIANT_FAMILIES.items()
            if any(_has_marker(hay, s) for s in spellings)}


def _yt_queries(artist: str, title: str, instrumental: bool,
                wanted: set | None = None) -> list[str]:
    """The searches a human would actually type, in order of preference."""
    t = title.replace("&", "and")
    a = (artist or "").replace("&", "and").strip()

    # If a wanted edit isn't already spelled out in the title (i.e. it came from
    # --variant), add it to the query so YouTube surfaces that cut at all.
    extra = " ".join(sorted(v for v in (wanted or set())
                            if not _has_marker(t.lower(), v)))
    if extra:
        t = f"{t} {extra}"

    if instrumental:
        if a:
            return [f"{a} {t} instrumental", f"{a} {t} official instrumental",
                    f"{t} instrumental", f"{t} karaoke"]
        return [f"{t} instrumental", f"{t} karaoke"]

    # Vocals wanted: ask for the RECORDING, not the music video.
    if a:
        return [f"{a} {t} lyrics", f"{a} {t} official audio",
                f"{a} {t} audio", f"{a} {t}"]
    return [f"{t} lyrics", f"{t} official audio", t]


def _score_yt_candidate(hit: dict, artist: str, title: str,
                        instrumental: bool, exclude_ids: set,
                        wanted: set | None = None) -> int:
    name = hit["title"].lower()
    channel = (hit.get("channel") or "").lower()
    duration = hit.get("duration")
    wanted = wanted or set()

    if hit["id"] in exclude_ids:
        return -10_000

    has_instrumental = any(m in name for m in _INSTRUMENTAL_MARKERS)

    if instrumental:
        score = 60 if has_instrumental else -60
        # A real instrumental beats someone's piano/guitar rendition.
        if any(w in name for w in ("piano", "guitar", "violin", "cover")):
            score -= 15
    else:
        # A vocals request must NEVER return a backing track. This is the bug
        # that made "Title.mp3" byte-identical to "Title (instrumental).mp3".
        if has_instrumental:
            return -10_000
        score = 0
        for marker, bonus in _VOCAL_BONUS:
            if marker in name:
                score += bonus
                break
        if "music video" in name:
            score -= 8   # music videos carry intro/outro dialogue

    for junk in _ALWAYS_JUNK:
        if _has_marker(name, junk):
            score -= 45
            break

    # Edits: reward the cut the reel actually played, punish the ones it didn't.
    # This is why "sped up"/"slowed"/"remix" are not blanket-junk — when the reel
    # used the sped up version, that IS the song Sam wants.
    for canon, spellings in _VARIANT_FAMILIES.items():
        present = any(_has_marker(name, s) for s in spellings)
        if canon in wanted:
            score += 25 if present else -25
        elif present:
            score -= 45

    if duration is not None:
        if duration < 45 or duration > 900:
            return -10_000   # clip, teaser, or an hour-long loop
        if 120 <= duration <= 420:
            score += 5

    if artist and artist.strip():
        a = artist.lower()
        if a in name or a in channel:
            score += 15
    if title.lower() in name:
        score += 10

    return score


def search_youtube(artist: str, title: str, instrumental: bool = False,
                   exclude_ids: set | None = None) -> str | None:
    """Search YouTube for the song and return the best match URL.

    `instrumental` genuinely changes the search — instrumental asks for a
    backing track, otherwise we ask for the recording WITH vocals and reject
    any instrumental/karaoke hit outright. `exclude_ids` blocks video IDs
    already used for another variant of the same song, so the two files can
    never come back identical.

    Edits (sped up / slowed / remix / live / ...) are honoured, not filtered:
    whatever cut the recognised title names — or `--variant` forces — is the cut
    we chase, because if the reel played the sped up version that IS the song.

    If artist is empty, runs a title-only query — what a human would type when
    recognition picked the wrong artist (common on instrumentals)."""
    exclude_ids = exclude_ids or set()
    wanted = _wanted_variants(title)
    who = f"{artist} - {title}" if artist and artist.strip() else f"{title} (title-only)"
    label = "instrumental" if instrumental else "with vocals"
    if wanted:
        label += ", " + "/".join(sorted(wanted))
    print(f"Searching YouTube for: {who} [{label}]...")

    best, best_score = None, -10_000
    for query in _yt_queries(artist, title, instrumental, wanted):
        for hit in _yt_search(query):
            score = _score_yt_candidate(hit, artist, title, instrumental,
                                        exclude_ids, wanted)
            if score > best_score:
                best, best_score = hit, score
        if best_score >= _GOOD_ENOUGH:
            break

    if best is None or best_score <= -1000:
        return None

    print(f"  -> {best['title']}")
    return f"https://www.youtube.com/watch?v={best['id']}"


def _yt_video_id(url: str) -> str:
    """Extract the 11-char video id from a watch URL."""
    if "v=" in url:
        return url.split("v=", 1)[1].split("&", 1)[0]
    return url.rstrip("/").rsplit("/", 1)[-1]


def download_youtube_mp3(youtube_url: str, output_path: Path, source_url: str = "") -> bool:
    """Download the YouTube video as MP3."""
    print(f"Downloading MP3...")

    # Download to a temp file first, then add metadata
    temp_output = output_path.parent / f"temp_{output_path.name}"

    cmd = [
        "yt-dlp",
        "-x",  # Extract audio
        "--audio-format", "mp3",
        "--audio-quality", "0",  # Best quality
        "-o", str(temp_output),
        "--no-playlist",
        "--quiet",
        "--progress",
        youtube_url
    ]

    result = subprocess.run(cmd, capture_output=True, text=True)

    if result.returncode != 0:
        print(f"Error downloading from YouTube: {result.stderr}")
        return False

    if not temp_output.exists():
        return False

    # Re-encode with ffmpeg to add source URL metadata
    if source_url:
        ffmpeg_cmd = ["ffmpeg", "-y", "-i", str(temp_output), "-q:a", "0", "-metadata", f"comment={source_url}", str(output_path)]
        subprocess.run(ffmpeg_cmd, capture_output=True, check=True)
        temp_output.unlink()
    else:
        temp_output.rename(output_path)

    return output_path.exists()


def update_script():
    """Download and install the latest version from GitHub."""
    import urllib.request

    GITHUB_RAW_URL = "https://raw.githubusercontent.com/samuelcodinggod/song-grab/master/song-grab"

    try:
        print("Checking for updates...")
        req = urllib.request.Request(GITHUB_RAW_URL, headers={"User-Agent": "song-grab"})
        with urllib.request.urlopen(req, timeout=30) as response:
            new_script = response.read().decode("utf-8")

        # Get the path of the current script
        script_path = Path(__file__).resolve()

        # Write the new version
        with open(script_path, "w") as f:
            f.write(new_script)

        print("Updated to the latest version!")
        sys.exit(0)

    except Exception as e:
        print(f"Update failed: {e}")
        sys.exit(1)


def get_video_metadata(url: str) -> tuple[str | None, str | None]:
    """Fetch the video's own title and id via yt-dlp, without downloading.
    Either value may be None if yt-dlp can't read it. Returns (title, id)."""
    cmd = [
        "yt-dlp",
        "--cookies-from-browser", "chrome",
        "--no-playlist",
        "--quiet",
        "--skip-download",
        "--print", "%(id)s\t%(title)s",
        url,
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
    except subprocess.TimeoutExpired:
        return None, None
    if result.returncode != 0 or not result.stdout.strip():
        return None, None
    # id first so a tab/newline inside the title can't break the split.
    parts = result.stdout.strip().split("\t", 1)
    vid = parts[0].strip() if parts and parts[0].strip() not in ("", "NA") else None
    title = parts[1].strip() if len(parts) > 1 and parts[1].strip() not in ("", "NA") else None
    return title, vid


async def raw_download(url: str):
    """Download the audio that's actually in a TikTok/Instagram video.

    No song identification — this grabs the video's own audio track (the
    voiceover plus whatever the creator mixed in), NOT the music track that
    TikTok/Instagram attributes to the post. TikTok photo slideshows have no
    video track, so for those it falls back to the attributed audio, which is
    the only audio that exists."""
    check_dependencies()
    check_output_directory()

    # TikTok photo slideshows have no video track — the attributed music is
    # the only audio there is, so fall back to it.
    if "tiktok.com" in url.lower() and "/photo/" in url.lower():
        print("Detected TikTok slideshow (no video track) — downloading its audio...")
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        output_path = OUTPUT_DIR / f"tiktok_slideshow_{timestamp}.mp3"
        if not download_tiktok_slideshow_audio(url, output_path, url):
            print("Slideshow audio download failed.")
            sys.exit(1)
        output_path = finalize_song(output_path, url)
        print(f"\nSaved: {output_path}")
        print("Done!")
        sys.exit(0)

    print("Fetching video info...")
    title, vid = get_video_metadata(url)

    if title and vid:
        basename = sanitize_filename(f"{title} [{vid}]")
    elif title:
        basename = sanitize_filename(title)
    elif vid:
        basename = f"raw_audio_{vid}"
    else:
        basename = "raw_audio_" + datetime.now().strftime("%Y%m%d_%H%M%S")

    output_path = OUTPUT_DIR / f"{basename}.mp3"

    existing = already_downloaded(output_path)
    if existing:
        print(f"\nAlready downloaded: {existing}")
        sys.exit(0)

    print("Downloading the video's audio track...")
    with tempfile.TemporaryDirectory() as temp_dir:
        source_audio = Path(temp_dir) / "source.mp3"
        cmd = [
            "yt-dlp",
            "--cookies-from-browser", "chrome",
            "-x",
            "--audio-format", "mp3",
            "--audio-quality", "0",
            "-o", str(source_audio),
            "--no-playlist",
            "--quiet",
            "--progress",
            url,
        ]
        result = subprocess.run(cmd, capture_output=True, text=True)

        if result.returncode != 0 or not source_audio.exists():
            err = (result.stderr or "").strip()[:300]
            print(f"Error downloading: {err}")
            sys.exit(1)

        # Re-encode to embed the source URL in the comment metadata.
        ffmpeg_cmd = [
            "ffmpeg", "-y", "-i", str(source_audio),
            "-q:a", "0", "-metadata", f"comment={url}", str(output_path),
        ]
        subprocess.run(ffmpeg_cmd, capture_output=True, check=True)

    output_path = finalize_song(output_path, url)
    print(f"\nSaved: {output_path}")
    print("Done!")
    sys.exit(0)


async def main():
    # Every search-based download now grabs BOTH variants (instrumental + normal)
    # per DOWNLOAD_VARIANTS. The legacy --instrumental / -i flags are accepted but
    # no-ops (kept so old muscle-memory / scripts don't error).
    sys.argv = [a for a in sys.argv if a not in ("--instrumental", "-i")]

    # Which cut of the track to grab. Recognition usually names it already
    # ("lovely - Sped Up Version"), and that's picked up automatically — these
    # flags are the manual override for when it reports the plain title but the
    # reel actually played an edit.
    #   --variant "sped up"   or the shorthands --sped-up --slowed --nightcore
    #                                           --remix --live --acoustic
    global VARIANT_HINT
    if "--variant" in sys.argv:
        i = sys.argv.index("--variant")
        if i + 1 < len(sys.argv):
            VARIANT_HINT = sys.argv[i + 1]
            del sys.argv[i:i + 2]
        else:
            del sys.argv[i]
    for canon in list(_VARIANT_FAMILIES):
        flag = "--" + canon.replace(" ", "-")
        if flag in sys.argv:
            VARIANT_HINT = f"{VARIANT_HINT} {canon}".strip()
            sys.argv = [a for a in sys.argv if a != flag]
    if VARIANT_HINT:
        print(f"Variant requested: {VARIANT_HINT}")

    # Handle --reindex — just rebuild every folder's _Song Links.rtf and exit.
    # (reindex_all() self-heals moved local sources first.)
    if "--reindex" in sys.argv:
        reindex_all()
        return

    # Handle --relink — re-find moved local source videos and repair their
    # shortcuts/links, without a full reindex prompt. (reindex rebuilds anyway.)
    if "--relink" in sys.argv:
        relink_ledger()
        reindex_all()
        return

    # Handle --watch — run the background folder watcher (used by the launchd
    # agent com.samgritton.song-sources). Keeps every folder's _Sources and
    # _Song Links.rtf in sync as songs are moved/duplicated between folders.
    # Runs until killed.
    if "--watch" in sys.argv:
        watch_loop()
        return

    # Handle --candidates / -c — run all 3 services and download each best match
    candidates_mode = False
    if "--candidates" in sys.argv or "-c" in sys.argv:
        candidates_mode = True
        sys.argv = [a for a in sys.argv if a not in ("--candidates", "-c")]

    # Handle --update flag
    if len(sys.argv) >= 2 and sys.argv[1] in ("--update", "-u", "update"):
        update_script()

    # Handle numeric start offset: "song 10 <url>" or "song 1:30 <url>" pinpoints
    # the N-second mark of the video. Useful for videos with multiple songs.
    start_offset = None
    if len(sys.argv) >= 2 and re.match(r'^\d+(:\d+)?$', sys.argv[1]):
        arg = sys.argv[1]
        if ':' in arg:
            m, s = arg.split(':')
            start_offset = int(m) * 60 + int(s)
        else:
            start_offset = int(arg)
        # Drop the offset arg so existing URL parsing still works
        sys.argv.pop(1)

    # Handle --raw flag
    if len(sys.argv) >= 2 and sys.argv[1] in ("--raw", "-r", "raw"):
        if len(sys.argv) >= 3:
            raw_url = sys.argv[2]
        else:
            try:
                raw_url = input("URL: ").strip()
                if not raw_url:
                    print("No URL provided.")
                    sys.exit(1)
            except (EOFError, KeyboardInterrupt):
                print()
                sys.exit(1)
        await raw_download(raw_url)

    # Handle --search flag (skip metadata, force Shazam/ACRCloud/AudD identification)
    search_mode = False
    if len(sys.argv) >= 2 and sys.argv[1] in ("--search", "-s", "search"):
        search_mode = True
        if len(sys.argv) >= 3:
            url = sys.argv[2]
        else:
            try:
                url = input("URL: ").strip()
                if not url:
                    print("No URL provided.")
                    sys.exit(1)
            except (EOFError, KeyboardInterrupt):
                print()
                sys.exit(1)
    elif len(sys.argv) < 2:
        # Prompt for URL - allows pasting without quotes
        try:
            url = input("URL: ").strip()
            if not url:
                print("No URL provided.")
                sys.exit(1)
        except (EOFError, KeyboardInterrupt):
            print()
            sys.exit(1)
    else:
        url = sys.argv[1]

    # Local media file? Identify the song embedded in it (no URL/metadata steps).
    local_file = resolve_local_path(url)
    if local_file:
        url = str(local_file)  # record the clean absolute path as provenance

    # Validate URL
    if not local_file and "drive.google.com" in url.lower() and "/folders/" in url.lower():
        print("Error: That's a Google Drive folder link.")
        print("Please share a link to a specific file instead (e.g. drive.google.com/file/d/...)")
        sys.exit(1)

    # Direct YouTube URL — skip identification, just download audio of the video.
    is_youtube = not local_file and any(d in url.lower() for d in ("youtube.com/watch", "youtu.be/", "youtube.com/shorts/", "music.youtube.com"))
    if is_youtube:
        check_dependencies()
        check_output_directory()
        print("YouTube URL detected — downloading audio directly...")
        title_cmd = ["yt-dlp", "--get-title", "--no-playlist", "--quiet", url]
        title_result = subprocess.run(title_cmd, capture_output=True, text=True)
        if title_result.returncode != 0 or not title_result.stdout.strip():
            print(f"Could not fetch YouTube title: {title_result.stderr.strip()[:200]}")
            sys.exit(1)
        yt_title = title_result.stdout.strip()
        # A direct YouTube URL is one specific video the user chose — there's no
        # search here to pick an instrumental vs. normal cut, so save it plainly.
        filename = sanitize_filename(f"{yt_title}.mp3")
        output_path = OUTPUT_DIR / filename
        existing = already_downloaded(output_path)
        if existing:
            print(f"\nSong already exists: {existing}")
            sys.exit(0)
        if not download_youtube_mp3(url, output_path, url):
            print("YouTube download failed.")
            sys.exit(1)
        output_path = finalize_song(output_path, url)
        print(f"\nSaved: {output_path}")
        print("Done!")
        sys.exit(0)

    if local_file:
        print(f"Local file detected — identifying the song in: {local_file.name}")
    elif not any(domain in url.lower() for domain in ["instagram.com", "tiktok.com", "drive.google.com"]):
        print("Warning: URL doesn't appear to be from Instagram, TikTok, or Google Drive.")
        print("Proceeding anyway...")

    # Check prerequisites
    check_dependencies()
    check_output_directory()

    # Create temp directory for intermediate files
    with tempfile.TemporaryDirectory() as temp_dir:
        temp_path = Path(temp_dir)
        source_audio = temp_path / "source.mp3"

        # Step 1: Try to get song info from page metadata (most accurate)
        song_info = None
        if candidates_mode:
            print("Candidates mode: skipping metadata, will run all 3 services and download each match...")
        elif search_mode or start_offset is not None:
            if start_offset is not None:
                print(f"Targeting {start_offset}s mark; skipping metadata, will identify song from audio...")
            else:
                print("Search mode: skipping metadata, will identify song from audio...")
        elif "tiktok.com" in url.lower():
            print("Checking TikTok for song metadata...")
            song_info = extract_tiktok_music_metadata(url)
            if song_info:
                print(f"Found song in TikTok metadata: {song_info['artist']} - {song_info['title']}")
        elif "instagram.com" in url.lower():
            print("Checking Instagram for song metadata...")
            song_info = extract_instagram_music_metadata(url)
            if song_info:
                print(f"Found song in Instagram metadata: {song_info['artist']} - {song_info['title']}")

        # Step 2: Get the source audio — extract from a local file, else download.
        if local_file:
            got_audio = extract_local_audio(local_file, source_audio)
        else:
            got_audio = download_source_audio(url, source_audio)
        if not got_audio:
            print("Failed to get audio from source.")
            sys.exit(1)

        # If metadata gave us a song, skip the all-services identification and
        # fall through to the single-download flow below.
        if not song_info:
            # Step 3: Run all 3 services on the raw audio across all segments.
            # Keeps every ACRCloud match >= 50, plus every unique AudD/Shazam match.
            print("\nRunning all services on raw audio...")
            seen_keys: set = set()
            candidates = await identify_song_candidates(
                source_audio, start_offset=start_offset, seen_keys=seen_keys
            )

            # Always also run Demucs vocal isolation and re-run services on the
            # instrumental stem — strips voiceovers / SFX that mask the music.
            print("\nIsolating vocals with Demucs and re-running services on stem...")
            stem_path = separate_vocals_demucs(source_audio, temp_path / "demucs_out")
            if stem_path:
                cleaned_audio = temp_path / "cleaned.mp3"
                shutil.copy2(stem_path, cleaned_audio)
                stem_candidates = await identify_song_candidates(
                    cleaned_audio,
                    start_offset=start_offset,
                    source_label="(stem)",
                    seen_keys=seen_keys,
                )
                candidates.extend(stem_candidates)

            # Final fallback: speed-shifted retries on raw audio (catches songs
            # played at non-standard tempo).
            if not candidates:
                print("\nNo matches yet. Trying speed-shifted retry segments...")
                for retry_count in range(3):
                    print(f"  Retry {retry_count + 1}/3")
                    extra = await retry_identify_song(source_audio, retry_count)
                    if extra:
                        candidates.append(extra)
                        break

            if not candidates:
                print("\nNo services could identify the song. Try Shazam on your phone.")
                failed_path = save_failed_url(url)
                print(f"Saved URL for later retry: {failed_path}")
                sys.exit(1)

            print(f"\nFound {len(candidates)} unique candidate(s):")
            for c in candidates:
                score_str = f" (score {c.get('score')})" if c.get('score') is not None else ""
                src_str = f" {c.get('source_label', '')}".rstrip() if c.get('source_label') else ""
                seg_str = f" [{c.get('segment')}]" if c.get('segment') else ""
                print(f"  - [{c.get('service')}]{src_str}{seg_str} {c['artist']} - {c['title']}{score_str}")

            # Multi-candidate path: parent folder named after first match,
            # each candidate in its own subfolder with .mp3 + .txt sidecar.
            if len(candidates) > 1:
                print(f"\nDownloading {len(candidates)} candidates as flat files into Music...")
                saved, dest = download_candidates_flat(candidates, url)
                if saved == 0:
                    print("\nAll candidate downloads failed.")
                    sys.exit(1)
                print(f"\nDone! {saved} candidate(s) saved (flat) into:\n  {dest}")
                print("Preview them, keep the one you want, then drag it into a category folder.")
                sys.exit(0)

            # Single candidate — fall through to existing single-download path.
            song_info = candidates[0]

        artist = song_info["artist"]
        title = song_info["title"]
        if song_info.get("source") != "tiktok_metadata":
            print(f"\nIdentified: {artist} - {title}")

        # Step 4: Download BOTH variants — instrumental backing track and the
        # normal with-vocals version — into OUTPUT_DIR.
        saved_any = False
        used_ids: set = set()   # never let two variants land on the same video
        for instrumental in DOWNLOAD_VARIANTS:
            variant = "instrumental" if instrumental else "normal"
            inst_suffix = " (instrumental)" if instrumental else ""
            if song_info.get("offset") is not None:
                timestamp = format_timestamp(song_info["offset"])
                filename = sanitize_filename(f"{title}{inst_suffix} {timestamp}.mp3")
            else:
                filename = sanitize_filename(f"{title}{inst_suffix}.mp3")
            output_path = OUTPUT_DIR / filename

            existing = already_downloaded(output_path)
            if existing:
                print(f"\n{variant.capitalize()} version already exists: {existing.name}")
                saved_any = True
                continue

            # Prefer TikTok direct audio (exact match) for the NORMAL version —
            # the source clip carries the real vocals. The instrumental always
            # comes from a YouTube "instrumental" search instead.
            downloaded = False
            if not instrumental and song_info.get("tiktok_audio_url"):
                print(f"\nDownloading {variant} version directly from TikTok...")
                downloaded = download_tiktok_direct_audio(song_info["tiktok_audio_url"], output_path, url)
                if downloaded:
                    finalize_song(output_path, url, reindex=False)
                    print(f"Saved: {output_path.name}")
                else:
                    print("Direct TikTok download failed, trying YouTube...")

            # Fall back to YouTube if no TikTok audio or download failed.
            if not downloaded:
                youtube_url = search_youtube(artist, title, instrumental=instrumental,
                                             exclude_ids=used_ids)
                if not youtube_url:
                    print(f"\nCould not find '{artist} - {title}' ({variant}) on YouTube.")
                    continue
                used_ids.add(_yt_video_id(youtube_url))
                print(f"\nFound on YouTube ({variant}): {youtube_url}")
                if not download_youtube_mp3(youtube_url, output_path, url):
                    print(f"Failed to download {variant} version from YouTube.")
                    continue
                finalize_song(output_path, url, reindex=False)
                print(f"Saved: {output_path.name}")

            saved_any = True

        if not saved_any:
            print("\nCould not download either version. Try searching manually.")
            sys.exit(1)

        reindex_all()
        print("\nDone!")


if __name__ == "__main__":
    asyncio.run(main())
